# ──────────────────────────────────────────────────────────────────────────────
# Jugurtha Fit Backend – Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# ⚠️  SECURITY: Never commit the real .env file to version control.
#     Copy this file to .env and fill in real values locally.
#     Generate SECRET_KEY with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ──────────────────────────────────────────────────────────────────────────────

APP_ENV=development
DATABASE_URL=postgresql://user:password@localhost/jugurtha_fit
# Keep true only when startup must create missing tables. Prefer Alembic and
# set false once migrations are part of the production release command.
AUTO_CREATE_TABLES=true
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
PUBLIC_WEB_URL=https://your-jugurtha-fit-domain.example
SUPPORT_EMAIL=support@your-jugurtha-fit-domain.example

RESEND_API_KEY=re_your_resend_api_key_here
RESEND_TEST_RECIPIENT=developer@example.com
MAIL_FROM=Jugurtha Fit <noreply@your-jugurtha-fit-domain.example>
MAIL_FROM_NAME=Jugurtha Fit

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Production always enforces verification even if this is mistakenly false.
REQUIRE_EMAIL_VERIFICATION=true

USDA_API_KEY=your_usda_api_key_here
EXERCISEDB_URL=https://exercisedb-apiii.vercel.app
