# ──────────────────────────────────────────────────────────────────────────────
# ForgeFit Backend – Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# ⚠️  SECURITY: Never commit the real .env file to version control.
#     Copy this file to .env and fill in real values locally.
#     Generate SECRET_KEY with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# ──────────────────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost/forgefit
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM=noreply@forgefit.com
MAIL_FROM_NAME=ForgeFit

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

DEBUG=false

# Set to false during beta to skip email verification.
# Must be added to Render → Environment Variables as well as local .env.
REQUIRE_EMAIL_VERIFICATION=true

USDA_API_KEY=your_usda_api_key_here
EXERCISEDB_URL=https://exercisedb-apiii.vercel.app
